# === Database ===
DATABASE_URL=sqlite:///./aircraft.db
# DATABASE_URL=postgresql://user:pass@localhost:5432/aircraft

# === Authentication ===
JWT_SECRET_KEY=replace-with-a-secure-random-string-min-32-chars
REFRESH_SECRET_KEY=replace-with-a-different-secure-string-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=30

# === CORS ===
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# === App ===
APP_ENV=development
